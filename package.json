{
  "name": "dsh-connect-meoo",
  "displayName": "DSH Connect 秒悟 Meoo",
  "description": "把秒悟 Meoo（meoo.com）的模型接进 DeepSeek Harness：浏览器 OAuth(PKCE) 一次授权后自动解析项目服务 AK，模型出现在 DSH 模型选择器里；插件设置页以 tab 展示账号、积分余额、模型目录、开关与诊断，输入框旁有积分胶囊读数，可选侧栏整页。",
  "version": "0.0.7",
  "author": "xinstart-1",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "meoo",
    "秒悟",
    "model-provider",
    "points",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preview:ui": "node scripts/preview-ui.mjs",
    "build": "tsdown && node scripts/copy-client.mjs && node scripts/check-client.mjs",
    "gate": "node scripts/gate.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "check": "node scripts/gate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinstart-1/dsh-connect-meoo.git"
  },
  "homepage": "https://github.com/xinstart-1/dsh-connect-meoo#readme",
  "bugs": {
    "url": "https://github.com/xinstart-1/dsh-connect-meoo/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.1 <0.3.0-0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.88.0 || >=1.0.0-0 <2.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@earendil-works/pi-ai": "^1.0.0",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
